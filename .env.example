# Copy to .env (never commit .env). Values from Supabase → Project Settings → API.
# Leave empty to run the app fully offline without the goaltender portal.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Where the goaltender portal is hosted, e.g. https://portal.example.se
EXPO_PUBLIC_PORTAL_URL=
